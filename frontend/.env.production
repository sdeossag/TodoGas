# API que consumen el APK de release y la web de producción. Desde que la API
# va detrás de CloudFront, es el mismo dominio que la web (infra/terraform); el
# ALB ya no atiende api.<dominio> directo. Debe estar cubierto por
# android/app/src/main/res/xml/network_security_config.xml.
VITE_API_BASE_URL=https://cmms.todogas.com.co

# La clave de Google Maps del navegador NO va aquí: es pública por naturaleza,
# pero no se versiona. Se pasa como variable de entorno al compilar
# (VITE_GOOGLE_MAPS_API_KEY=... npm run android:prod), y Vite la toma antes que
# este archivo. Sin clave, el mapa sale como coordenadas con enlace a Google Maps.
