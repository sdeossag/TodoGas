<?xml version="1.0" encoding="utf-8"?>
<!--
  Trafico en claro bloqueado hacia la API y el bucket de evidencia: las fotos
  y firmas viajan con datos de paciente y ubicacion.

  Dominios de produccion (infra/terraform): la API en api.cmms.todogas.com.co y
  la evidencia en el bucket todogas-prod-evidencia (us-east-1). boto3 firma las
  URLs con el endpoint global o el regional de S3 segun la configuracion, asi
  que van los dos.

  debug-overrides solo aplica a builds debuggables, asi que el APK de release
  no confia en CAs de usuario aunque el bloque siga en el archivo.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.cmms.todogas.com.co</domain>
        <domain includeSubdomains="false">todogas-prod-evidencia.s3.amazonaws.com</domain>
        <domain includeSubdomains="false">todogas-prod-evidencia.s3.us-east-1.amazonaws.com</domain>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
