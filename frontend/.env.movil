# APK de desarrollo (npm run android:local). El telefono o emulador llega al
# runserver del computador por `adb reverse tcp:8000 tcp:8000`, asi que la
# API es su propio localhost. Solo funciona con el APK de depuracion, que
# permite http hacia localhost (android/app/src/debug/res/xml).
VITE_API_BASE_URL=http://localhost:8000
