{"nodes": [{"id": "docs_requirements_rnf_com_02_cumplimiento_ley_1581_de_2012_proteccion_de_datos_personales_habeas_da", "label": "RNF-COM-02", "file_type": "document", "source_file": "docs/requirements/RNF-COM-02-cumplimiento-ley-1581-de-2012-proteccion-de-datos-personales-habeas-da.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TENSION documentada explicitamente: el derecho de supresion (Habeas Data, Ley 1581 de 2012) choca con el deber de retencion de registros GMP/INVIMA. Los datos personales de representantes de hospitales (nombre + cargo del firmante) no pueden anonimizarse si estan vinculados a registros de mantenimiento auditables, dada la superposicion con el requisito regulatorio de GMP. La solucion adoptada es anonimizacion (no eliminacion fisica) solo para usuarios inactivos por mas de 2 anios y solo cuando no comprometa la integridad de registros auditables; la tension se documenta en la politica de privacidad de la empresa en lugar de resolverse tecnicamente en todos los casos."}, {"id": "concepts_ley_1581_de_2012", "label": "Ley 1581 de 2012", "file_type": "concept", "source_file": "docs/requirements/RNF-COM-02-cumplimiento-ley-1581-de-2012-proteccion-de-datos-personales-habeas-da.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concepts_decreto_1377_de_2013", "label": "Decreto 1377 de 2013", "file_type": "concept", "source_file": "docs/requirements/RNF-COM-02-cumplimiento-ley-1581-de-2012-proteccion-de-datos-personales-habeas-da.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concepts_superintendencia_industria_comercio", "label": "Superintendencia de Industria y Comercio", "file_type": "concept", "source_file": "docs/requirements/RNF-COM-02-cumplimiento-ley-1581-de-2012-proteccion-de-datos-personales-habeas-da.md", "source_location": null, "